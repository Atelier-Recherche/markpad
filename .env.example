SERVER_PORT=1234
SERVER_HOST=0.0.0.0
WEB_PORT=8080
PUBLIC_SERVER_URL=http://localhost:1234
PUBLIC_WEB_URL=http://localhost:8080
ALLOWED_API_KEYS=dev-key
REDIS_URL=redis://redis:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
MAX_ROOM_PASSWORD_LENGTH=128
SESSION_MAX_IDLE_MS=31536000000
SESSION_CLEANUP_INTERVAL_MS=3600000
JWT_SECRET=change-me-in-production
# Première valeur en base pour « nouveaux comptes autorisés » (modifiable ensuite par l’admin). false = fermer les inscriptions au premier démarrage.
# ALLOW_PUBLIC_SIGNUP=true
ADMIN_EMAILS=
MARKPAD_SQLITE_PATH=./data/markpad.db
# SMTP = envoi uniquement. Ne pas mettre les ports IMAP (993) ou POP (995) — ce sont les serveurs entrants pour lire le courrier.
# Type cPanel : reprendre le « Serveur sortant » + port SSL (souvent 465) ou STARTTLS (587). Ex. OVH : ssl0.ovh.net.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Mot de passe : avec Docker Compose, chaque `$` doit être `$$` (ex. secret$p4ss → secret$$p4ss).
# Le serveur et `npm run test-smtp` réduisent `$$` en `$` ; les guillemets ne suffisent pas à bloquer l’interpolation Compose.
SMTP_PASS=
EMAIL_FROM=markpad@localhost
# Optionnel : true = TLS direct (465), false = STARTTLS (587). Par défaut : 465 → true, 587 → false.
# SMTP_SECURE=
# Délais (ms) pour éviter d’attendre ~20 s si le serveur ne répond pas.
# SMTP_CONNECTION_TIMEOUT_MS=12000
# SMTP_SOCKET_TIMEOUT_MS=25000
# Dépannage certificat SMTP uniquement : SMTP_TLS_REJECT_UNAUTHORIZED=false
